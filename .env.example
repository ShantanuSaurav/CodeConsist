# ==============================================================================
# CodeQuest environment
#
# Everything works with NO configuration at all: `npm install && npm run dev`
# gives you accounts, progress, the leaderboard, JavaScript execution in a Node
# sandbox and Python through WebAssembly. Copy this file to `.env` only if you
# want one of the optional extras below. The API, `npm start` and Vite all read
# .env; VITE_API_PROXY follows API_PORT automatically if you leave it unset.
# ==============================================================================

# --- API server ---------------------------------------------------------------
# Port for the local API (server/). Defaults to 4000.
# Note: this is API_PORT, not PORT - dev harnesses set PORT for the web server.
# API_PORT=4000

# Signing key for session tokens. One is generated into
# server/data/.jwt-secret on first run, so you only need this in production.
# JWT_SECRET=replace-me-with-a-long-random-string

# --- Web dev server -----------------------------------------------------------
# Where Vite proxies /api to. Change it if you moved the API off port 4000.
# VITE_API_PROXY=http://localhost:4000

# --- Optional: compiled languages ---------------------------------------------
# JavaScript and Python need nothing. To also run C, C++, Java or Go in the
# playground, point these at a Judge0 instance (self-hosted or RapidAPI).
# Leave them unset and the app says so plainly rather than faking a result.
# VITE_JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# VITE_JUDGE0_API_KEY=your_rapidapi_key
# VITE_JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
