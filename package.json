{
  "name": "codequest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch-path=./server/index.js --watch-path=./server/content.js --watch-path=./server/db.js --watch-path=./server/build.js --watch-path=./server/runner --watch-path=./src/data --watch-path=./src/lib server/index.js",
    "build": "npm run content:index && tsc && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc --noEmit",
    "content:index": "node scripts/build-index.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "check": "npm run content:index && npm run typecheck && npm run content:validate && npm run content:lint",
    "content:lint": "node scripts/lint-content.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "description": "CodeQuest - a daily practice app for developers. Runs end to end on localhost.",
  "engines": {
    "node": ">=22.9"
  }
}
