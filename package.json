{
  "name": "codeconsist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=./server/index.js --watch-path=./server/env.js --watch-path=./server/content.js --watch-path=./server/db.js --watch-path=./server/build.js --watch-path=./server/auth.js --watch-path=./server/admin.js --watch-path=./server/admin-auth.js --watch-path=./server/ai.js --watch-path=./server/ai-questions.js --watch-path=./server/custom-challenges.js --watch-path=./server/billing.js --watch-path=./server/billing-routes.js --watch-path=./server/payments.js --watch-path=./server/oauth.js --watch-path=./server/oauth-routes.js --watch-path=./server/drafts-routes.js --watch-path=./server/settings.js --watch-path=./server/settings-routes.js --watch-path=./server/progress-rules.js --watch-path=./server/progress-routes.js --watch-path=./server/activity.js --watch-path=./server/activity-routes.js --watch-path=./server/client-ip.js --watch-path=./server/rate-limit.js --watch-path=./server/cors-policy.js --watch-path=./server/progression.js --watch-path=./server/password-reset.js --watch-path=./server/units.js --watch-path=./server/preferences-routes.js --watch-path=./server/habits.js --watch-path=./server/review-routes.js --watch-path=./server/concept-cards.js --watch-path=./server/assessment-routes.js --watch-path=./server/leagues.js --watch-path=./server/leagues-routes.js --watch-path=./server/leagues-admin.js --watch-path=./server/judge0.js --watch-path=./server/excel.js --watch-path=./server/runner --watch-path=./src/modules/challenges/content --watch-path=./src/modules/challenges/schema.ts --watch-path=./src/platform --watch-path=./src/types --watch-path=./src/app/content-specs.ts server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "content:validate": "node scripts/validate-content.mjs",
    "check": "npm run typecheck && npm run lint:boundaries && npm run content:parity && npm run content:validate && npm run content:verify-expansion && npm run content:lint && npm run content:extras && npm run content:stats && npm run test",
    "content:verify-expansion": "node scripts/verify-question-expansion.mjs",
    "content:lint": "node scripts/lint-content.mjs",
    "content:extras": "node scripts/validate-extras.mjs",
    "content:stats": "node scripts/content-stats.mjs --check",
    "content:links": "node scripts/validate-extras.mjs --links",
    "content:parity": "node scripts/check-content-parity.mjs",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "1.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "description": "CodeConsist - the developer training environment. 834 lessons and 12 stage tests across 3 tracks, guided Learn mode, articles, roadmaps, real code execution and an admin console. Runs end to end on localhost.",
  "engines": {
    "node": ">=22.9"
  }
}
